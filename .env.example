LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Optional. Leave empty unless you explicitly want provider-error failover.
LLM_FALLBACK_MODEL=
# none keeps token use and latency predictable; use low/medium only after eval.
LLM_REASONING_EFFORT=none
# auto = try direct JSON first, then fall back to conversion; convert = always use two stages
# direct = experimental one-call JSON; text = plain Markdown response
TRIP_OUTPUT_MODE=auto
LLM_TIMEOUT_SECONDS=90
# Optional pricing used only for local cost estimates in JSONL metrics.
# Set the current provider price per 1M tokens; leave empty to report null cost.
LLM_INPUT_PRICE_USD_PER_MILLION=
LLM_OUTPUT_PRICE_USD_PER_MILLION=
# Public travel-data APIs use no keys. This only controls their HTTP timeout.
TRAVEL_API_TIMEOUT_SECONDS=20
